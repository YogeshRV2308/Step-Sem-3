public class PalindromeChecker {

    /**
     * 1. Iterative Approach: Two-pointer technique moving inward.
     * Time Complexity: O(n) | Space Complexity: O(1)
     */
    public static boolean isPalindromeIterative(String text) {
        if (text == null) return false;
        
        int left = 0;
        int right = text.length() - 1;

        while (left < right) {
            if (text.charAt(left) != text.charAt(right)) {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }

    /**
     * 2. Recursive Approach: Compare outer characters and shrink boundaries.
     * Time Complexity: O(n) | Space Complexity: O(n) due to recursion stack & substring allocations
     */
    public static boolean isPalindromeRecursive(String text) {
        if (text == null) return false;
        
        // Base cases: empty or single-character string is a palindrome
        if (text.length() <= 1) {
            return true;
        }

        // Compare first and last characters
        if (text.charAt(0) != text.charAt(text.length() - 1)) {
            return false;
        }

        // Recurse on the inner substring
        return isPalindromeRecursive(text.substring(1, text.length() - 1));
    }

    /**
     * 3. Array Reversal Approach: Convert string to character array, reverse, and compare.
     * Time Complexity: O(n) | Space Complexity: O(n) for the array and string copy
     */
    public static boolean isPalindromeArrayReversal(String text) {
        if (text == null) return false;

        char[] original = text.toCharArray();
        char[] reversed = new char[original.length];

        for (int i = 0; i < original.length; i++) {
            reversed[i] = original[original.length - 1 - i];
        }

        return String.valueOf(original).equals(String.valueOf(reversed));
    }

    /**
     * Helper method to verify all three approaches agree and print results.
     */
    public static void verifyPalindrome(String input) {
        boolean iterativeResult = isPalindromeIterative(input);
        boolean recursiveResult = isPalindromeRecursive(input);
        boolean arrayReversalResult = isPalindromeArrayReversal(input);

        // Sanity check assertion: all three must agree
        if (iterativeResult != recursiveResult || recursiveResult != arrayReversalResult) {
            throw new IllegalStateException("Implementation mismatch detected for input: " + input);
        }

        String iterLabel = iterativeResult ? "Palindrome" : "Not Palindrome";
        String recurLabel = recursiveResult ? "Palindrome" : "Not Palindrome";
        String arrLabel = arrayReversalResult ? "Palindrome" : "Not Palindrome";

        System.out.printf("Input: \"%s\"%n", input);
        System.out.printf("Iterative: %s | Recursive: %s | Array Reversal: %s%n%n", 
                iterLabel, recurLabel, arrLabel);
    }

    public static void main(String[] args) {
        verifyPalindrome("madam");
        verifyPalindrome("hello");
        verifyPalindrome("racecar");
        verifyPalindrome("a");
    }
}